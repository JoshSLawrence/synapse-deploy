        "[concat(variables('workspaceId'), '/datasets/ds_e2e')]"
      ],
      "name": "[concat(parameters('workspaceName'), '/df_e2e')]",
      "properties": {
        "type": "MappingDataFlow",
        "typeProperties": {
          "scriptLines": [
            "source(allowSchemaDrift: true,",
            "     validateSchema: false,",
            "     ignoreNoFilesFound: false) ~> src",
            "src sink(allowSchemaDrift: true,",
            "     validateSchema: false,",
            "     umask: 0022,",
            "     preCommands: [],",
            "     postCommands: [],",
            "     skipDuplicateMapInputs: true,",
            "     skipDuplicateMapOutputs: true) ~> snk"
          ],
          "sinks": [
            {
              "dataset": {
                "referenceName": "ds_e2e",
                "type": "DatasetReference"
              },
              "name": "snk"
            }
          ],
          "sources": [
            {
              "dataset": {
                "referenceName": "ds_e2e",
                "type": "DatasetReference"
              },
              "name": "src"
            }
          ],
          "transformations": []
        }

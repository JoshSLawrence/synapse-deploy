{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "ls_e2e_storage_properties_typeProperties_url": {
      "defaultValue": "https://stexample.dfs.core.windows.net",
      "type": "string"
    },
    "mpe-e2e-blob_properties_privateLinkResourceId": {
      "defaultValue": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Storage/storageAccounts/stexample",
      "type": "string"
    },
    "workspaceName": {
      "metadata": "Workspace name",
      "type": "string"
    }
  },
  "resources": [
    {
      "apiVersion": "2019-06-01-preview",
      "dependsOn": [],
      "name": "[concat(parameters('workspaceName'), '/pl_e2e')]",
      "properties": {
        "activities": [
          {
            "dependsOn": [],
            "name": "Wait",
            "type": "Wait",
            "typeProperties": {
              "waitTimeInSeconds": 1
            },
            "userProperties": []
          }
        ],
        "annotations": [],
        "parameters": {
          "p_bracket": {
            "defaultValue": "[x]",
            "type": "string"
          },
          "p_number_text": {
            "defaultValue": "45.0",
            "type": "string"
          }
        },
        "policy": {
          "elapsedTimeMetric": {}
        }
      },
      "type": "Microsoft.Synapse/workspaces/pipelines"
    },
    {
      "apiVersion": "2019-06-01-preview",

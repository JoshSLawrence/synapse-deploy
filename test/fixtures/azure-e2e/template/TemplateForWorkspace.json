      "properties": {
        "activities": [
          {
            "dependsOn": [],
            "name": "Run flow",
            "policy": {
              "retry": 0,
              "retryIntervalInSeconds": 30,
              "secureInput": false,
              "secureOutput": false,
              "timeout": "0.12:00:00"
            },
            "type": "ExecuteDataFlow",
            "typeProperties": {
              "compute": {
                "computeType": "General",
                "coreCount": 8
              },
              "dataflow": {
                "datasetParameters": {
                  "snk": {},
                  "src": {}
                },
                "parameters": {},
                "referenceName": "df_e2e",
                "type": "DataFlowReference"
              },
              "staging": {},
              "traceLevel": "Fine"
            },
            "userProperties": []
          }
        ],
        "annotations": [],
        "policy": {
          "elapsedTimeMetric": {}
        }
      },
      "type": "Microsoft.Synapse/workspaces/pipelines"
    },
    {

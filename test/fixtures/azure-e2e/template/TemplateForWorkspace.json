        },
        "schema": [],
        "type": "DelimitedText",
        "typeProperties": {
          "columnDelimiter": ",",
          "escapeChar": "\\",
          "firstRowAsHeader": true,
          "location": {
            "fileName": "e2e.csv",
            "fileSystem": "e2e",
            "type": "AzureBlobFSLocation"
          },
          "quoteChar": "\""
        }
      },
      "type": "Microsoft.Synapse/workspaces/datasets"
    },

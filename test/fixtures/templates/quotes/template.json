{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": "Workspace name"
    },
    "p_quote": {
      "type": "string"
    },
    "p_apos": {
      "type": "string"
    }
  },
  "variables": {
    "workspaceId": "[concat('Microsoft.Synapse/workspaces/', parameters('workspaceName'))]"
  },
  "resources": [
    {
      "name": "[concat(parameters('workspaceName'), '/It''s a \"pipe\"')]",
      "type": "Microsoft.Synapse/workspaces/pipelines",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "activities": [
          {
            "name": "Wait",
            "type": "Wait",
            "dependsOn": [],
            "userProperties": [],
            "typeProperties": {
              "waitTimeInSeconds": 1
            }
          }
        ],
        "annotations": [],
        "description": "[concat('it''s', ' ', parameters('p_apos'))]",
        "parameters": {
          "msg": {
            "type": "string",
            "defaultValue": "[parameters('p_quote')]"
          },
          "plain": {
            "type": "string",
            "defaultValue": "say \"hi\" and it's fine"
          }
        }
      },
      "dependsOn": []
    },
    {
      "name": "[concat(parameters('workspaceName'), '/ls_o''brien')]",
      "type": "Microsoft.Synapse/workspaces/linkedServices",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "type": "AzureBlobFS",
        "typeProperties": {
          "url": "[parameters('p_apos')]"
        },
        "annotations": []
      },
      "dependsOn": []
    }
  ]
}

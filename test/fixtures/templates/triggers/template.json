{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": "Workspace name"
    },
    "p_path": {
      "type": "string"
    },
    "p_start": {
      "type": "string",
      "defaultValue": "2026-01-01T00:00:00Z"
    }
  },
  "variables": {
    "workspaceId": "[concat('Microsoft.Synapse/workspaces/', parameters('workspaceName'))]"
  },
  "resources": [
    {
      "name": "[concat(parameters('workspaceName'), '/pl_target')]",
      "type": "Microsoft.Synapse/workspaces/pipelines",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "activities": [
          {
            "name": "Wait",
            "type": "Wait",
            "dependsOn": [],
            "userProperties": [],
            "typeProperties": {
              "waitTimeInSeconds": 1
            }
          }
        ],
        "annotations": [],
        "parameters": {
          "path": {
            "type": "string"
          }
        }
      },
      "dependsOn": []
    },
    {
      "name": "[concat(parameters('workspaceName'), '/tr_schedule')]",
      "type": "Microsoft.Synapse/workspaces/triggers",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "runtimeState": "Stopped",
        "pipelines": [
          {
            "pipelineReference": {
              "referenceName": "pl_target",
              "type": "PipelineReference"
            },
            "parameters": {
              "path": "[parameters('p_path')]"
            }
          }
        ],
        "type": "ScheduleTrigger",
        "typeProperties": {
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "startTime": "[parameters('p_start')]",
            "timeZone": "UTC"
          }
        },
        "annotations": []
      },
      "dependsOn": [
        "[concat(variables('workspaceId'), '/pipelines/pl_target')]"
      ]
    },
    {
      "name": "[concat(parameters('workspaceName'), '/tr_blob')]",
      "type": "Microsoft.Synapse/workspaces/triggers",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "runtimeState": "Stopped",
        "pipelines": [
          {
            "pipelineReference": {
              "referenceName": "pl_target",
              "type": "PipelineReference"
            },
            "parameters": {
              "path": "\\\\host\\share\\in"
            }
          }
        ],
        "type": "BlobEventsTrigger",
        "typeProperties": {
          "blobPathBeginsWith": "/data/blobs/in",
          "ignoreEmptyBlobs": true,
          "scope": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Storage/storageAccounts/stexample",
          "events": [
            "Microsoft.Storage.BlobCreated"
          ]
        },
        "annotations": []
      },
      "dependsOn": [
        "[concat(variables('workspaceId'), '/pipelines/pl_target')]"
      ]
    }
  ]
}

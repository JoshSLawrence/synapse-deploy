{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": "Workspace name",
      "defaultValue": "devws"
    },
    "devws-WorkspaceDefaultSqlServer_connectionString": {
      "type": "secureString"
    },
    "devws-WorkspaceDefaultStorage_properties_typeProperties_url": {
      "type": "string",
      "defaultValue": "https://stexample.dfs.core.windows.net"
    }
  },
  "variables": {
    "workspaceId": "[concat('Microsoft.Synapse/workspaces/', parameters('workspaceName'))]"
  },
  "resources": [
    {
      "name": "[concat(parameters('workspaceName'), '/devws-WorkspaceDefaultStorage')]",
      "type": "Microsoft.Synapse/workspaces/linkedServices",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "type": "AzureBlobFS",
        "typeProperties": {
          "url": "[parameters('devws-WorkspaceDefaultStorage_properties_typeProperties_url')]"
        },
        "annotations": []
      },
      "dependsOn": []
    },
    {
      "name": "[concat(parameters('workspaceName'), '/devws-WorkspaceDefaultSqlServer')]",
      "type": "Microsoft.Synapse/workspaces/linkedServices",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "type": "AzureSqlDW",
        "typeProperties": {
          "connectionString": "[parameters('devws-WorkspaceDefaultSqlServer_connectionString')]"
        },
        "annotations": []
      },
      "dependsOn": []
    },
    {
      "name": "[concat(parameters('workspaceName'), '/WorkspaceSystemIdentity')]",
      "type": "Microsoft.Synapse/workspaces/credentials",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "type": "ManagedIdentity",
        "typeProperties": {}
      },
      "dependsOn": []
    },
    {
      "name": "[concat(parameters('workspaceName'), '/x-devws-WorkspaceDefaultStorage-copy')]",
      "type": "Microsoft.Synapse/workspaces/linkedServices",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "type": "AzureBlobFS",
        "typeProperties": {
          "url": "https://stexample.dfs.core.windows.net"
        },
        "annotations": []
      },
      "dependsOn": []
    },
    {
      "name": "[concat(parameters('workspaceName'), '/ds_default')]",
      "type": "Microsoft.Synapse/workspaces/datasets",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "linkedServiceName": {
          "referenceName": "devws-WorkspaceDefaultStorage",
          "type": "LinkedServiceReference"
        },
        "type": "Binary",
        "typeProperties": {
          "location": {
            "type": "AzureBlobFSLocation",
            "fileSystem": "data"
          }
        },
        "annotations": []
      },
      "dependsOn": [
        "[concat(variables('workspaceId'), '/linkedServices/devws-WorkspaceDefaultStorage')]"
      ]
    },
    {
      "name": "[concat(parameters('workspaceName'), '/pl_default')]",
      "type": "Microsoft.Synapse/workspaces/pipelines",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "activities": [
          {
            "name": "Copy",
            "type": "Copy",
            "dependsOn": [],
            "userProperties": [],
            "typeProperties": {
              "source": {
                "type": "BinarySource"
              },
              "sink": {
                "type": "BinarySink"
              }
            },
            "inputs": [
              {
                "referenceName": "ds_default",
                "type": "DatasetReference"
              }
            ],
            "linkedServiceName": {
              "referenceName": "devws-WorkspaceDefaultSqlServer",
              "type": "LinkedServiceReference"
            }
          }
        ],
        "annotations": []
      },
      "dependsOn": [
        "[concat(variables('workspaceId'), '/datasets/ds_default')]",
        "[concat(variables('workspaceId'), '/linkedServices/devws-WorkspaceDefaultSqlServer')]"
      ]
    },
    {
      "name": "[concat(parameters('workspaceName'), '/lakedb_default')]",
      "type": "Microsoft.Synapse/workspaces/databases",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "Ddls": [
          {
            "ActionType": "CREATE",
            "OldEntity": null,
            "NewEntity": {
              "Name": "lakedb_default",
              "EntityType": "DATABASE",
              "Origin": {
                "Type": "SPARK"
              },
              "Properties": {
                "IsSyMSCDMDatabase": true
              },
              "Source": {
                "Provider": "ADLS",
                "Location": "abfss://data@stexample.dfs.core.windows.net/lakedb_default",
                "Properties": {
                  "FormatType": "csv",
                  "LinkedServiceName": "devws-WorkspaceDefaultStorage"
                }
              }
            },
            "Source": {
              "Type": "SPARK"
            }
          }
        ]
      },
      "dependsOn": [
        "[concat(variables('workspaceId'), '/linkedServices/devws-WorkspaceDefaultStorage')]"
      ]
    },
    {
      "name": "[concat(parameters('workspaceName'), '/ls_other')]",
      "type": "Microsoft.Synapse/workspaces/linkedServices",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "type": "AzureSqlDW",
        "typeProperties": {
          "connectionString": "Server=x"
        },
        "annotations": []
      },
      "dependsOn": []
    },
    {
      "name": "[concat(parameters('workspaceName'), '/ls_user')]",
      "type": "Microsoft.Synapse/workspaces/linkedServices",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "type": "AzureSqlDatabase",
        "typeProperties": {
          "connectionString": "Server=y"
        },
        "annotations": []
      },
      "dependsOn": [
        "[concat(variables('workspaceId'), '/linkedServices/devws-WorkspaceDefaultStorage')]"
      ]
    }
  ]
}

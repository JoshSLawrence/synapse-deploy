{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": "Workspace name"
    }
  },
  "variables": {
    "workspaceId": "[concat('Microsoft.Synapse/workspaces/', parameters('workspaceName'))]"
  },
  "resources": [
    {
      "name": "[concat(parameters('workspaceName'), '/tr_d')]",
      "type": "Microsoft.Synapse/workspaces/triggers",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "runtimeState": "Stopped",
        "pipelines": [
          {
            "pipelineReference": {
              "referenceName": "pl_c",
              "type": "PipelineReference"
            }
          }
        ],
        "type": "ScheduleTrigger",
        "typeProperties": {
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "startTime": "2026-01-01T00:00:00Z",
            "timeZone": "UTC"
          }
        },
        "annotations": []
      },
      "dependsOn": [
        "[concat(variables('workspaceId'), '/pipelines/pl_c')]"
      ]
    },
    {
      "name": "[concat(parameters('workspaceName'), '/pl_c')]",
      "type": "Microsoft.Synapse/workspaces/pipelines",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "activities": [
          {
            "name": "Wait",
            "type": "Wait",
            "dependsOn": [],
            "userProperties": [],
            "typeProperties": {
              "waitTimeInSeconds": 1
            }
          }
        ],
        "annotations": []
      },
      "dependsOn": [
        "[concat(variables('workspaceId'), '/datasets/ds_b')]"
      ]
    },
    {
      "name": "[concat(parameters('workspaceName'), '/ds_b')]",
      "type": "Microsoft.Synapse/workspaces/datasets",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "linkedServiceName": {
          "referenceName": "ls_a",
          "type": "LinkedServiceReference"
        },
        "type": "Binary",
        "typeProperties": {
          "location": {
            "type": "AzureBlobFSLocation",
            "fileSystem": "data"
          }
        },
        "annotations": []
      },
      "dependsOn": [
        "[concat(variables('workspaceId'), '/linkedServices/ls_a')]"
      ]
    },
    {
      "name": "[concat(parameters('workspaceName'), '/ls_a')]",
      "type": "Microsoft.Synapse/workspaces/linkedServices",
      "apiVersion": "2019-06-01-preview",
      "properties": {
        "type": "AzureBlobFS",
        "typeProperties": {
          "url": "https://stexample.dfs.core.windows.net"
        },
        "annotations": []
      },
      "dependsOn": []
    }
  ]
}
